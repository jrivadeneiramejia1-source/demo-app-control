rules_version = '2';
// Reglas de la DEMO (proyecto demo-app-control). Se pegan en Firebase > Firestore Database > Reglas (Rules) > Publicar (Publish).
// Solo entran las cinco cuentas de prueba de personas.js. Cualquier otra cuenta (o alguien sin cuenta) no puede leer ni escribir nada.
// Fases 1 y 2: todas las cuentas de prueba pueden leer y escribir las colecciones de la demo.
// En las fases siguientes se agregan los permisos por rol (por ejemplo, solo "Autoriza compras" aprueba una compra).
service cloud.firestore {
  match /databases/{database}/documents {

    // Correo de cada cuenta de prueba -> su rol. Debe coincidir con personas.js.
    function cuentas() {
      return {
        'ana.perez@example.com': 'jefe',
        'luis.rodriguez@example.com': 'compras',
        'marta.gomez@example.com': 'carros',
        'carlos.pinto@example.com': 'conductor',
        'sofia.herrera@example.com': 'asistente'
      };
    }
    function esDemo() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in cuentas();
    }

    // Colecciones de los módulos. No se permiten subcolecciones ni otras colecciones.
    match /{col}/{id} {
      allow read: if esDemo() && col in ['equipos', 'compras', 'vehiculos', 'reuniones', 'avisos', 'demo'];
      allow write: if esDemo() && col in ['equipos', 'compras', 'vehiculos', 'reuniones', 'avisos', 'demo'];
    }
  }
}
