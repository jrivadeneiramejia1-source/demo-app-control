rules_version = '2';
// Reglas de la DEMO (proyecto fir-app-control-d8494). Se pegan en Firebase > Firestore Database > Reglas (Rules) > Publicar (Publish).
// Entran las personas de prueba de personas.js y las cuentas propias que se registraron con un código válido
// (su perfil en usuarios/<uid> dice el rol y si el acceso está activo). Sin eso, nadie puede leer ni escribir nada.
// El rol de una cuenta propia lo pone el código: la persona no lo puede escoger ni cambiar.
// Cada persona solo puede hacer lo que le toca (lo cumple Firebase, no solo la pantalla):
//   Gerente (Ricardo): ve todo; solo autoriza o rechaza las compras que pide la Jefe.
//   Jefe (Ana): carga y reinicia los datos de prueba, autoriza las compras y puede hacer cualquier paso (menos autorizarse a sí misma).
//   Compras (Luis): registra la compra autorizada (proveedor, valor, factura) y las compras hechas sin autorización.
//   Bodega (Sofía): entradas, salidas, conteos, entregas y recibe lo comprado.
//   Reuniones: la Jefe confirma lo que entendió el agente y reparte; Compras, Transporte y Bodega informan lo que hay y la Jefe
//   autoriza la comida y los carros (escoge el conductor);
//   el Conductor confirma el viaje, Logística alista, el Profesional confirma si va y Administrativo registra el acta.
//   Vehículos: el Conductor reporta novedades con foto y registra salidas y llegadas; Transporte y Bodega revisan, asignan y
//   actualizan documentos.
//   Todos: piden material y piden compras a su nombre, y marcan sus avisos como leídos.
service cloud.firestore {
  match /databases/{database}/documents {

    // Correo de cada persona de prueba -> su rol. Debe coincidir con personas.js.
    function cuentas() {
      return {
        'ricardo.fuentes@example.com': 'gerente',
        'ana.perez@example.com': 'jefe',
        'daniel.ortiz@example.com': 'equipos',
        'valentina.ruiz@example.com': 'soporte',
        'luis.rodriguez@example.com': 'compras',
        'sofia.herrera@example.com': 'asistente',
        'marta.gomez@example.com': 'carros',
        'carlos.pinto@example.com': 'conductor',
        'pedro.castillo@example.com': 'logistica',
        'laura.medina@example.com': 'profesional',
        'natalia.vargas@example.com': 'administrativo'
      };
    }
    function ROLES() { return ['gerente', 'jefe', 'equipos', 'soporte', 'compras', 'asistente', 'carros', 'conductor', 'logistica', 'profesional', 'administrativo']; }
    function esPrueba() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in cuentas();
    }
    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function perfil() { return get(rutaPerfil()).data; }
    // Cuenta propia con perfil y acceso activo.
    function esCuenta() { return request.auth != null && !esPrueba() && exists(rutaPerfil()) && perfil().activo == true; }
    function esDemo() { return esPrueba() || esCuenta(); }
    function rol() { return esPrueba() ? cuentas()[request.auth.token.email] : perfil().rol; }
    // Cuenta propia (no persona de prueba) con uno de estos roles.
    function esCuentaDe(roles) { return esCuenta() && perfil().rol in roles; }
    function esDireccion(r) { return r in ['gerente', 'jefe']; }
    function rutaCodigo(c, r) {
      return esDireccion(r) ? /databases/$(database)/documents/codigosDireccion/$(c) : /databases/$(database)/documents/codigos/$(c);
    }
    // Quiénes informan lo que hay en cada tarea de reunión (la comida y los carros los autoriza la Jefe).
    function informanEn(tipo) {
      return tipo in ['refrigerios', 'almuerzo'] ? ['compras', 'asistente']
        : tipo == 'carros' ? ['carros', 'asistente']
        : tipo == 'logistica' ? ['asistente'] : [];
    }
    function rutaNec(id) { return /databases/$(database)/documents/necesidades/$(id); }
    function rutaEnt(id) { return /databases/$(database)/documents/entregas/$(id); }
    function esFecha(f) { return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    // El historial solo crece: una línea nueva al final y las viejas iguales.
    function historialSigue() {
      return nuevo().historial is list && nuevo().historial.size() == antes().get('historial', []).size() + 1
        && nuevo().historial[0:antes().get('historial', []).size()] == antes().get('historial', []);
    }
    // ¿Ya llegó ese día (AAAA-MM-DD) en Colombia (UTC-5)? Desde las 00:00 hora de Colombia.
    function yaFue(f) {
      return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2])) + duration.value(5, 'h') <= request.time;
    }
    // Estados a los que cada quien puede pasar su tarea de reunión.
    function estadosDe(tipo) {
      return tipo in ['viaje', 'asistencia'] ? ['listo', 'no-va']
        : tipo == 'logistica' ? ['pendiente', 'listo']
        : tipo == 'acta' ? ['listo'] : [];
    }
    // Cambio que le toca decidir al Gerente: una compra que pidió la Jefe pasa a autorizada o rechazada, o sale de ahí.
    function decideGerente() {
      return antes().get('pideRol', '') == 'jefe' && nuevo().get('estado', '') != antes().get('estado', '')
        && (antes().get('estado', '') in ['pedido', 'rechazado'] || nuevo().get('estado', '') in ['autorizado', 'rechazado']);
    }
    function esJefe() { return esDemo() && rol() == 'jefe'; }
    function esGerente() { return esDemo() && rol() == 'gerente'; }
    // Permisos extra que el Gerente o la Jefe le marcan a una cuenta propia (las personas de prueba no tienen).
    function extras() { return esCuenta() ? perfil().get('extras', []) : []; }
    function tieneExtra(x) { return x in extras(); }
    // Compras, la Jefe, o la persona de Bodega con el permiso extra «compra».
    function esCompras() { return esDemo() && (rol() == 'compras' || rol() == 'jefe' || (rol() == 'asistente' && tieneExtra('compra'))); }
    // Administrativa con el permiso extra «encargada»: ve todo lo de las reuniones y la bandeja de correos.
    function esEncargada() { return esDemo() && rol() == 'administrativo' && tieneExtra('encargada'); }
    function esBodega() { return esDemo() && (rol() == 'asistente' || rol() == 'jefe'); }
    function nuevo() { return request.resource.data; }
    function antes() { return resource.data; }
    function soloCambia(campos) { return nuevo().diff(antes()).affectedKeys().hasOnly(campos); }

    // Marca de los datos de prueba: solo la Jefe los carga o reinicia.
    match /demo/{id} {
      allow read: if esDemo();
      allow write: if esJefe();
    }

    // Módulos que en esta fase solo se ven: los escribe la Jefe al cargar los datos de prueba.
    match /{col}/{id} {
      allow read: if esDemo() && col in ['equipos'];
      allow write: if esJefe() && col in ['equipos'];
    }

    // Vehículos: hoja de vida de cada carro. Transporte y Bodega asignan, actualizan documentos y estado;
    // el Conductor solo cambia estado (salida/llegada), kilometraje (nunca hacia atrás) y conductor, con una línea de historial.
    match /vehiculos/{id} {
      allow read: if esDemo();
      allow create, delete: if esJefe();
      allow update: if esJefe()
        || (esDemo() && rol() in ['carros', 'asistente'] && soloCambia(['conductor', 'soat', 'tecno', 'estado', 'km', 'historial', 'ultimaEntrega'])
            && nuevo().km is number && nuevo().km >= antes().km && nuevo().estado in ['disponible', 'en-uso', 'en-taller']
            && esFecha(nuevo().soat) && esFecha(nuevo().tecno) && historialSigue())
        // El Conductor solo pasa el carro de disponible a en uso (o al revés) junto con la salida o llegada que registra en ese mismo momento.
        || (esDemo() && rol() == 'conductor' && soloCambia(['estado', 'km', 'conductor', 'historial', 'ultimaEntrega'])
            && antes().estado in ['disponible', 'en-uso'] && nuevo().estado in ['disponible', 'en-uso'] && nuevo().estado != antes().estado
            && nuevo().km is number && nuevo().km >= antes().km && nuevo().km <= antes().km + 3000 && historialSigue()
            && nuevo().ultimaEntrega is string && !exists(rutaEnt(nuevo().ultimaEntrega))
            && getAfter(rutaEnt(nuevo().ultimaEntrega)).data.vehiculoId == id
            && getAfter(rutaEnt(nuevo().ultimaEntrega)).data.km == nuevo().km
            && getAfter(rutaEnt(nuevo().ultimaEntrega)).data.tipo == (nuevo().estado == 'en-uso' ? 'salida' : 'llegada'));
    }

    // Novedades de un carro: siempre con foto, sin revisar al nacer. Las revisan Transporte, Bodega o la Jefe.
    match /novedades/{id} {
      allow read: if esDemo();
      // La Jefe de prueba las crea al cargar los datos de ejemplo.
      allow create: if (esJefe() && esPrueba()) || (esDemo() && rol() in ['conductor', 'carros', 'asistente', 'jefe']
        && nuevo().keys().hasOnly(['vehiculoId', 'placa', 'tipo', 'fecha', 'km', 'descripcion', 'foto', 'reporta', 'reportaRol', 'costo', 'revisada', 'revisadaPor', 'revisadaEn', 'nota'])
        && nuevo().reportaRol == rol() && nuevo().revisada == false
        && nuevo().tipo in ['llanta', 'choque', 'rayon', 'mantenimiento', 'otro']
        && nuevo().foto is string && nuevo().foto.size() < 400000 && nuevo().foto.matches('^data:image/jpeg;base64,.*')
        && nuevo().costo is number && (nuevo().costo == 0 || rol() != 'conductor'));
      allow update: if (esJefe() || (esDemo() && rol() in ['carros', 'asistente']))
        && soloCambia(['costo', 'revisada', 'revisadaPor', 'revisadaEn', 'nota']) && nuevo().costo is number && nuevo().costo >= 0
        && antes().revisada == false && nuevo().revisada == true && nuevo().get('nota', '').size() <= 160;
      allow delete: if esJefe();
    }

    // Salidas y llegadas de los carros: con las 5 fotos (cada una pequeña) y la revisión. No se cambian después.
    match /entregas/{id} {
      allow read: if esDemo();
      allow create: if (esJefe() && esPrueba()) || (esDemo() && rol() in ['conductor', 'carros', 'asistente', 'jefe']
        && nuevo().porRol == rol() && nuevo().tipo in ['salida', 'llegada']
        && nuevo().fotos.keys().hasOnly(['frente', 'atras', 'izquierda', 'derecha', 'llantas'])
        && nuevo().fotos.keys().hasAll(['frente', 'atras', 'izquierda', 'derecha', 'llantas'])
        && nuevo().fotos.frente is string && nuevo().fotos.frente.size() < 200000
        && nuevo().fotos.atras is string && nuevo().fotos.atras.size() < 200000
        && nuevo().fotos.izquierda is string && nuevo().fotos.izquierda.size() < 200000
        && nuevo().fotos.derecha is string && nuevo().fotos.derecha.size() < 200000
        && nuevo().fotos.llantas is string && nuevo().fotos.llantas.size() < 200000);
      allow update, delete: if esJefe();
    }

    // Reuniones: las arma la Jefe con lo que entendió el agente. Administrativo la marca como realizada al registrar el acta.
    // Ajustes que se escriben solo a mano en la consola de Firebase. ajustes/buzon = { uid: <UID de la cuenta robot> }.
    match /ajustes/{id} {
      allow read, write: if false;
    }
    function rutaAjusteBuzon() { return /databases/$(database)/documents/ajustes/buzon; }
    // La cuenta robot del buzón: su UID tiene que ser el que Jeiler guardó a mano en ajustes/buzon
    // (así nadie se hace pasar por ella aunque se registre primero con ese correo).
    function esRobotBuzon() {
      return request.auth != null && request.auth.token.email == 'buzon.demo@example.com'
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(rutaAjusteBuzon()) && request.auth.uid == get(rutaAjusteBuzon()).data.uid;
    }
    // Bandeja de correos: los correos que llegan al Gmail de prueba. Los sube un Apps Script con la cuenta robot
    // (solo puede crear aquí: no tiene perfil ni rol, así que no ve ni toca nada más).
    // Los leen la Jefe y la Administrativa encargada; la Jefe los reparte con el agente o los borra.
    match /buzon/{id} {
      allow read: if esJefe() || esEncargada();
      allow create: if esRobotBuzon()
        && id.size() <= 40 && nuevo().keys().hasOnly(['asunto', 'texto', 'fecha'])
        && nuevo().asunto is string && nuevo().asunto.size() <= 300
        && nuevo().texto is string && nuevo().texto.size() >= 10 && nuevo().texto.size() <= 8000
        && nuevo().fecha is string && nuevo().fecha.size() <= 40;
      allow update: if false;
      allow delete: if esJefe();
    }

    match /reuniones/{id} {
      allow read: if esDemo();
      allow create, delete: if esJefe();
      // Administrativo: solo en la misma escritura que guarda el acta de ESA reunión, el día de la reunión o después,
      // y agregando una sola línea al historial.
      allow update: if esJefe()
        || (esDemo() && rol() == 'administrativo' && antes().estado in ['programada', 'reprogramada']
            && nuevo().estado == 'realizada' && soloCambia(['estado', 'historial', 'actaId']) && yaFue(antes().fecha)
            && nuevo().historial.size() == antes().get('historial', []).size() + 1
            && get(rutaNec(nuevo().actaId)).data.estado == 'pendiente'
            && getAfter(rutaNec(nuevo().actaId)).data.tipo == 'acta'
            && getAfter(rutaNec(nuevo().actaId)).data.reunionId == id
            && getAfter(rutaNec(nuevo().actaId)).data.estado == 'listo');
    }

    // Lo que le toca a cada rol en una reunión (una tarea por documento). Cada quien cambia solo la suya,
    // sin tocar de qué reunión es, qué es ni a quién le toca.
    match /necesidades/{id} {
      allow read: if esDemo();
      // Las crea la Jefe (también el viaje del conductor, al autorizar los carros).
      allow create: if esJefe();
      // Cada quien decide SU tarea una vez (mientras está pendiente). El acta, el día de la reunión o después.
      allow update: if esJefe()
        || (esDemo() && antes().responsableRol == rol() && antes().estado == 'pendiente'
            && soloCambia(['estado', 'por', 'en', 'motivo', 'conductor', 'items', 'acta'])
            && nuevo().estado in estadosDe(antes().tipo)
            && (antes().tipo != 'acta' || yaFue(antes().fechaReunion)))
        // Compras, Transporte y Bodega agregan lo que hay (un informe a la vez, sin tocar los de los demás) para que la Jefe decida.
        || (esDemo() && rol() in informanEn(antes().tipo) && antes().estado == 'pendiente' && soloCambia(['informes'])
            && nuevo().informes is list && nuevo().informes.size() == antes().get('informes', []).size() + 1 && nuevo().informes.size() <= 20
            && nuevo().informes == antes().get('informes', []).concat([nuevo().informes[nuevo().informes.size() - 1]])
            && nuevo().informes[nuevo().informes.size() - 1].rol == rol()
            && nuevo().informes[nuevo().informes.size() - 1].texto is string
            && nuevo().informes[nuevo().informes.size() - 1].texto.size() <= 200)
        // El conductor que no puede devuelve los carros para que la Jefe escoja otro.
        //   Tiene que decir cuál de sus viajes deja (y ese viaje queda en «no-va» en la misma escritura).
        || (esDemo() && rol() == 'conductor' && antes().tipo == 'carros' && antes().estado == 'autorizado'
            && nuevo().estado == 'pendiente' && nuevo().conductor == '' && soloCambia(['estado', 'conductor', 'motivo', 'devuelto'])
            && nuevo().devuelto is string && get(rutaNec(nuevo().devuelto)).data.tipo == 'viaje'
            && get(rutaNec(nuevo().devuelto)).data.estado in ['pendiente', 'listo']
            && getAfter(rutaNec(nuevo().devuelto)).data.carrosId == id
            && getAfter(rutaNec(nuevo().devuelto)).data.estado == 'no-va');
      allow delete: if esJefe();
    }

    // Bodega: artículos y movimientos.
    match /articulos/{id} {
      allow read: if esDemo();
      // La cantidad nunca queda negativa (si dos personas sacan al tiempo lo último, la segunda recibe un error).
      allow create, update: if esBodega() && nuevo().cantidad is number && nuevo().cantidad >= 0;
      allow delete: if esJefe();
    }
    match /movimientos/{id} {
      allow read: if esDemo();
      allow create: if esJefe() || (esBodega() && nuevo().por is string && nuevo().porRol == rol());
      allow update, delete: if esJefe();
    }

    // Pedidos de material: cada quien pide a su nombre; la bodega los entrega o los cierra.
    match /solicitudes/{id} {
      allow read: if esDemo();
      allow create: if esDemo() && (nuevo().pideRol == rol() || esJefe()) && (nuevo().estado == 'pendiente' || esJefe());
      allow update: if esBodega();
      allow delete: if esJefe();
    }

    // Compras. Pasos: pedido -> autorizado (o rechazado) -> comprado -> recibido.
    match /compras/{id} {
      allow read: if esDemo();
      // Pedir: a su propio nombre y en estado "pedido". Compras también registra compras hechas sin autorización.
      // La Jefe de prueba crea cualquier compra porque carga y reinicia los datos de ejemplo.
      allow create: if (esJefe() && esPrueba())
        || (esDemo() && nuevo().pideRol == rol() && nuevo().estado == 'pedido')
        || (esCompras() && nuevo().estado == 'sin-autorizar');
      allow update: if
        // La Jefe de prueba puede todo (reinicia los datos). Una Jefe con cuenta propia también, menos cambiar quién pidió
        // y menos decidir una compra que pidió ella (esa la decide el Gerente).
        (esJefe() && (esPrueba() || (!decideGerente() && nuevo().get('pideRol', '') == antes().get('pideRol', ''))))
        // El Gerente autoriza o rechaza solo lo que pidió la Jefe, sin cambiar cantidad ni valor.
        || (esGerente() && antes().estado == 'pedido' && antes().get('pideRol', '') == 'jefe'
            && nuevo().estado in ['autorizado', 'rechazado']
            && soloCambia(['estado', 'autoriza', 'motivoRechazo', 'historial']))
        // Comprar (autorizada -> comprada): Compras, sin tocar lo autorizado.
        || (esCompras() && antes().estado == 'autorizado' && nuevo().estado == 'comprado'
            && soloCambia(['estado', 'proveedor', 'valorReal', 'fechaCompra', 'factura', 'historial']))
        // Recibir (comprada -> recibida): la bodega.
        || (esBodega() && antes().estado == 'comprado' && nuevo().estado == 'recibido'
            && soloCambia(['estado', 'entregadoA', 'historial']));
      allow delete: if esJefe();
    }

    // Perfiles de las cuentas propias.
    match /usuarios/{uid} {
      // Cada quien lee el suyo; el Gerente y el Jefe con cuenta propia ven todos (panel «Personas y códigos»).
      // Las personas de prueba (clave pública) no ven ni manejan cuentas propias.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if esCuentaDe(['gerente', 'jefe']);
      // Crear el perfil: solo el dueño, con un código que exista, esté activo y sea del mismo rol.
      // Los códigos de Gerente y Jefe son de un solo uso: se borran en la misma escritura.
      allow create: if request.auth != null && request.auth.uid == uid && !esPrueba()
        && nuevo().keys().hasOnly(['nombre', 'correo', 'rol', 'codigo', 'activo', 'en'])
        && nuevo().rol in ROLES() && nuevo().activo == true
        && nuevo().nombre is string && nuevo().nombre.size() >= 3 && nuevo().nombre.size() <= 60
        && nuevo().correo == request.auth.token.email
        && nuevo().codigo is string
        && exists(rutaCodigo(nuevo().codigo, nuevo().rol))
        && get(rutaCodigo(nuevo().codigo, nuevo().rol)).data.activo == true
        && get(rutaCodigo(nuevo().codigo, nuevo().rol)).data.rol == nuevo().rol
        && (!esDireccion(nuevo().rol) || !existsAfter(rutaCodigo(nuevo().codigo, nuevo().rol)));
      // Cambiar rol, pausar o marcar permisos extra: el Gerente a cualquiera; el Jefe a todos menos Gerentes y Jefes. Nadie a sí mismo.
      allow update: if esCuentaDe(['gerente', 'jefe']) && request.auth.uid != uid
        && soloCambia(['rol', 'activo', 'extras'])
        && nuevo().rol in ROLES() && nuevo().activo is bool
        && nuevo().get('extras', []) is list && nuevo().get('extras', []).size() <= 5
        && nuevo().get('extras', []).hasOnly(['compra', 'actas', 'encargada'])
        && (perfil().rol == 'gerente' || (!esDireccion(antes().rol) && !esDireccion(nuevo().rol)));
      allow delete: if esCuentaDe(['gerente']);
    }

    // Códigos de los roles de trabajo (no Gerente ni Jefe). Solo los ven el Gerente y el Jefe con cuenta propia.
    match /codigos/{codigo} {
      allow read: if esCuentaDe(['gerente', 'jefe']);
      allow create: if esCuentaDe(['gerente', 'jefe'])
        && nuevo().keys().hasOnly(['rol', 'activo', 'por', 'en'])
        && nuevo().rol in ROLES() && !esDireccion(nuevo().rol) && nuevo().activo == true
        && codigo.size() >= 12;
      allow update: if false;
      // resource == null: ya lo había borrado otra persona (dos cambiando el código a la vez).
      allow delete: if esCuentaDe(['gerente', 'jefe']);
    }

    // Códigos de Gerente y Jefe: solo los ve y crea el Gerente, y sirven una sola vez.
    match /codigosDireccion/{codigo} {
      allow read: if esCuentaDe(['gerente']);
      allow create: if esCuentaDe(['gerente'])
        && nuevo().keys().hasOnly(['rol', 'activo', 'por', 'en'])
        && esDireccion(nuevo().rol) && nuevo().activo == true
        && codigo.size() >= 12;
      allow update: if false;
      // Lo borra el Gerente, o quien lo está usando para crear su perfil en esa misma escritura.
      allow delete: if esCuentaDe(['gerente'])
        || (request.auth != null && !exists(rutaPerfil()) && getAfter(rutaPerfil()).data.codigo == codigo);
    }

    // Avisos de la campana: cualquiera los crea; cada quien solo cambia SU marca de leído (con su id de cuenta).
    // La Jefe puede reescribirlos (al cargar o reiniciar los datos de prueba se reemplazan los avisos de ejemplo).
    match /avisos/{id} {
      allow read: if esDemo();
      allow create: if esDemo();
      allow update: if esJefe()
        || (esDemo() && soloCambia(['leido'])
            && nuevo().leido.diff(antes().get('leido', {})).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if esJefe();
    }

    // Teléfonos con avisos activados (para mandar la notificación al teléfono de cada persona).
    match /suscripciones/{id} {
      allow read: if esDemo();
      allow create, update: if esDemo() && nuevo().rol == rol();
      allow delete: if esDemo();
    }
  }
}
