rules_version = '2';
// Reglas de la DEMO (proyecto fir-app-control-d8494). Se pegan en Firebase > Firestore Database > Reglas (Rules) > Publicar (Publish).
// Entran las personas de prueba de personas.js y las cuentas propias que se registraron con un código válido
// (su perfil en usuarios/<uid> dice el rol y si el acceso está activo). Sin eso, nadie puede leer ni escribir nada.
// El rol de una cuenta propia lo pone el código: la persona no lo puede escoger ni cambiar.
// Cada persona solo puede hacer lo que le toca (lo cumple Firebase, no solo la pantalla):
//   Gerente: ve todo a detalle, sin autorizar. Solo el Gerente general (permiso extra «general», que se marca a mano en la consola)
//   autoriza las compras de más del monto que él fija (ajustesApp/compras) y las que pide la Coordinadora, y lo que él pide nace
//   autorizado. Coordinador de compras: autoriza las demás compras (las de más del monto pasan después al Gerente general).
//   Ninguno maneja personas ni códigos.
//   Jefe: carga y reinicia los datos de prueba (ya NO autoriza compras), maneja personas,
//   niveles e invitaciones (solo con cuenta propia; nunca invita ni toca a otra Jefe ni a un Gerente: esos se crean con un código
//   que se pone a mano en la consola de Firebase) y puede hacer cualquier paso (menos autorizarse a sí misma).
//   Nivel por módulo: lo que dice el rol, salvo que la Jefe le haya puesto otro a esa persona (usuarios/<uid>.permisos).
//   Las cuentas propias necesitan el correo confirmado. Las personas de prueba se pueden apagar (ajustesApp/seguridad).
//   Compras: registra la compra autorizada (proveedor, valor, factura) y las compras hechas sin autorización.
//   Bodega: entradas, salidas, conteos, entregas y recibe lo comprado.
//   Reuniones: la Jefe confirma lo que entendió el agente y reparte; Compras, Transporte y Bodega informan lo que hay y la Jefe
//   autoriza la comida y los carros (escoge el conductor);
//   el Conductor confirma el viaje, Logística alista, el Profesional confirma si va y Administrativo registra el acta.
//   Equipos: el Encargado pide la baja de un equipo y solo la Jefe la aprueba; Soporte y la Jefe verifican (escanean) los equipos.
//   Vehículos: el Conductor reporta novedades con foto y registra salidas y llegadas; Transporte y Bodega revisan, asignan y
//   actualizan documentos. Los tanqueos (combustible, con la foto del recibo) los crea quien tenga nivel en Vehículos (menos «solo ver»)
//   a su nombre; no se cambian después (solo la Jefe).
//   Proveedores: los ven Compras, la Coordinadora, Bodega, Financiero, Gerente y la Jefe; los crean y editan Compras, la Jefe y Bodega con el
//   extra «compra». Solo la Jefe los borra (la app no deja borrar uno que ya tiene compras).
//   Reservas de carro (viajes que no son reuniones): las pide quien tenga nivel de trabajo en Vehículos (Conductor, Transporte, Bodega y la Jefe)
//   a su nombre; Transporte, Bodega o la Jefe las aprueban (escogen un carro con los papeles al día y que no esté en el taller, y el conductor)
//   o las rechazan; nadie aprueba ni rechaza lo suyo. La salida del carro queda ligada a la reserva.
//   Todos: piden material y piden compras a su nombre, y marcan sus avisos como leídos.
service cloud.firestore {
  match /databases/{database}/documents {

    // Personas de prueba: su correo es «rol.nombre.apellido@example.com» (inventado) y el rol es lo primero. Así no hace falta una
    // lista larga (que gasta el límite de expresiones de las reglas). Cualquiera con la clave pública entra con ellas: por eso la Jefe
    // las puede apagar (ajustesApp/seguridad). Debe coincidir con personas.js (lo comprueba pruebas/reglas.mjs).
    function ROLES() { return ['gerente', 'jefe', 'equipos', 'soporte', 'compras', 'coordcompras', 'asistente', 'carros', 'conductor', 'logistica', 'profesional', 'administrativo', 'colaborador', 'financiero', 'consulta']; }
    function correoDePrueba() {
      return request.auth.token.email is string
        && request.auth.token.email.matches('^(gerente|jefe|equipos|soporte|compras|coordcompras|asistente|carros|conductor|logistica|profesional|administrativo|colaborador|financiero|consulta)[.][a-z.]+@example[.]com$');
    }
    // Interruptor: la Jefe (cuenta propia) puede apagar las personas de prueba (ajustesApp/seguridad.personasPrueba = false)
    // cuando la app pase a uso real, porque su clave es pública.
    function pruebasActivas() {
      return !exists(/databases/$(database)/documents/ajustesApp/seguridad)
        || get(/databases/$(database)/documents/ajustesApp/seguridad).data.get('personasPrueba', true) == true;
    }
    function esPrueba() {
      return request.auth != null
        && correoDePrueba()
        && pruebasActivas();
    }
    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function perfil() { return get(rutaPerfil()).data; }
    // Cuenta propia con el correo confirmado, perfil y acceso activo.
    function esCuenta() { return request.auth != null && !esPrueba() && request.auth.token.email_verified == true && exists(rutaPerfil()) && perfil().activo == true; }
    function esDemo() { return esPrueba() || esCuenta(); }
    function rol() { return esPrueba() ? request.auth.token.email.split('[.]')[0] : perfil().rol; }
    // Cuenta propia (no persona de prueba) con uno de estos roles.
    function esCuentaDe(roles) { return esCuenta() && perfil().rol in roles; }
    function esDireccion(r) { return r in ['gerente', 'jefe']; }
    function rutaCodigo(c, r) {
      return esDireccion(r) ? /databases/$(database)/documents/codigosDireccion/$(c) : /databases/$(database)/documents/codigos/$(c);
    }
    // Quiénes informan lo que hay en cada tarea de reunión (la comida y los carros los autoriza la Jefe).
    function informanEn(tipo) {
      return tipo in ['refrigerios', 'almuerzo'] ? ['compras', 'asistente']
        : tipo == 'carros' ? ['carros', 'asistente']
        : tipo == 'logistica' ? ['asistente'] : [];
    }
    function rutaNec(id) { return /databases/$(database)/documents/necesidades/$(id); }
    function rutaEnt(id) { return /databases/$(database)/documents/entregas/$(id); }
    function esFecha(f) { return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    // El historial solo crece: una línea nueva al final y las viejas iguales.
    function historialSigue() {
      let h = antes().get('historial', []);
      return nuevo().historial is list && nuevo().historial.size() == h.size() + 1 && (h.size() == 0 || nuevo().historial[0:h.size()] == h);
    }
    // ¿Ya llegó ese día (AAAA-MM-DD) en Colombia (UTC-5)? Desde las 00:00 hora de Colombia.
    function yaFue(f) {
      return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2])) + duration.value(5, 'h') <= request.time;
    }
    // Estados a los que cada quien puede pasar su tarea de reunión.
    function estadosDe(tipo) {
      return tipo in ['viaje', 'asistencia'] ? ['listo', 'no-va']
        : tipo == 'logistica' ? ['pendiente', 'listo']
        : tipo == 'acta' ? ['listo'] : [];
    }
    // Nivel base de cada rol en cada módulo (debe coincidir con personas.js; lo comprueba pruebas/reglas.mjs).
    // (Una cadena de «si» en vez de un mapa grande: así cada consulta gasta pocas de las 1000 expresiones que permite Firebase.)
    function baseDe(r) {
      return r == 'gerente' ? { 'equipos': 'ver', 'inventario': 'gerente', 'vehiculos': 'ver', 'reuniones': 'ver' }
        : r == 'jefe' ? { 'equipos': 'jefe', 'inventario': 'jefe', 'vehiculos': 'jefe', 'reuniones': 'jefe' }
        : r == 'equipos' ? { 'equipos': 'encargado', 'inventario': 'pide', 'vehiculos': 'no', 'reuniones': 'no' }
        : r == 'soporte' ? { 'equipos': 'soporte', 'inventario': 'pide', 'vehiculos': 'no', 'reuniones': 'no' }
        : r == 'compras' ? { 'equipos': 'no', 'inventario': 'compra', 'vehiculos': 'no', 'reuniones': 'informa' }
        : r == 'coordcompras' ? { 'equipos': 'no', 'inventario': 'coordina', 'vehiculos': 'no', 'reuniones': 'no' }
        : r == 'asistente' ? { 'equipos': 'no', 'inventario': 'bodega', 'vehiculos': 'autoriza', 'reuniones': 'informa' }
        : r == 'carros' ? { 'equipos': 'no', 'inventario': 'pide', 'vehiculos': 'autoriza', 'reuniones': 'informa' }
        : r == 'conductor' ? { 'equipos': 'no', 'inventario': 'pide', 'vehiculos': 'reporta', 'reuniones': 'asiste' }
        : r == 'logistica' ? { 'equipos': 'no', 'inventario': 'pide', 'vehiculos': 'no', 'reuniones': 'logistica' }
        : r == 'profesional' ? { 'equipos': 'no', 'inventario': 'pide', 'vehiculos': 'no', 'reuniones': 'asiste' }
        : r == 'administrativo' ? { 'equipos': 'no', 'inventario': 'pide', 'vehiculos': 'no', 'reuniones': 'actas' }
        : r == 'colaborador' ? { 'equipos': 'no', 'inventario': 'pide', 'vehiculos': 'no', 'reuniones': 'ver' }
        : r == 'financiero' ? { 'equipos': 'no', 'inventario': 'finanzas', 'vehiculos': 'no', 'reuniones': 'ver' }
        : r == 'consulta' ? { 'equipos': 'no', 'inventario': 'ver', 'vehiculos': 'ver', 'reuniones': 'no' }
        : {};
    }
    // Lo que la Jefe le marcó a una cuenta propia (permisos por módulo); las personas de prueba usan siempre el de su rol.
    function nivel(m) {
      return esCuenta() ? perfil().get('permisos', {}).get(m, baseDe(perfil().rol)[m]) : baseDe(rol())[m];
    }
    function esJefe() { return esDemo() && rol() == 'jefe'; }
    function esGerente() { return esDemo() && rol() == 'gerente'; }
    // Gerente general: el único Gerente que autoriza compras y cambia el monto. Lo que él pide nace autorizado. Los demás Gerentes ven, no autorizan.
    function esGerenteGeneral() { return esGerente() && tieneExtra('general'); }
    // Coordinador de compras: autoriza las compras (hasta el monto del Gerente) y revisa las hechas sin autorización. No las hace.
    function esCoordinador() { return esDemo() && nivel('inventario') == 'coordina'; }
    // Permisos extra que el Gerente o la Jefe le marcan a una cuenta propia (y los fijos de las personas de prueba).
    function extras() { return esCuenta() ? perfil().get('extras', []) : esPrueba() ? extrasPrueba() : []; }
    // Permisos extra de tres personas de prueba (deben coincidir con personas.js): Ángel (Soporte) revisa las actas, Solanyi es encargada de reuniones y Oscar es el Gerente general.
    function extrasPrueba() {
      return request.auth.token.email == 'soporte.angel.ortiz@example.com' ? ['actas'] : request.auth.token.email == 'administrativo.solanyi.surquira@example.com' ? ['encargada']
        : request.auth.token.email == 'gerente.oscar.munoz@example.com' ? ['general'] : [];
    }
    // Cada permiso extra solo vale para su rol (igual que personas.js): «compra» en Bodega, «actas» en Soporte, «encargada» en Administrativo y «general» en Gerente.
    // «general» (el Gerente general) NO lo puede marcar la Jefe (solo se pone a mano en la consola de Firebase: ver «usuarios» más abajo).
    function tieneExtra(x) { return x in extras() && rol() == (x == 'compra' ? 'asistente' : x == 'actas' ? 'soporte' : x == 'general' ? 'gerente' : 'administrativo'); }
    // Compras, la Jefe, o la persona de Bodega con el permiso extra «compra».
    function esCompras() {
      let n = nivel('inventario');
      return esDemo() && (n in ['compra', 'jefe'] || (n == 'bodega' && tieneExtra('compra')));
    }
    // Puede pedir material y compras a su nombre (con «solo ver» o «sin acceso» no).
    function puedePedir() { return esDemo() && nivel('inventario') in ['pide', 'finanzas', 'coordina', 'compra', 'bodega', 'gerente', 'jefe']; }
    function veInventario() { return esDemo() && nivel('inventario') != 'no'; }
    // Quien solo pide material (nivel «pide») no ve los movimientos de la bodega, y en una cuenta real solo ve SUS pedidos y compras
    // (los que llevan su pideUid). Las personas de prueba (demo) ven todo.
    function veMovimientos() { return veInventario() && nivel('inventario') != 'pide'; }
    function veLoSuyo() { return veInventario() && (nivel('inventario') != 'pide' || esPrueba() || antes().get('pideUid', '') == request.auth.uid); }
    // Lo que la persona pone al pedir: marca de su propia cuenta, máximo 5 líneas y 3 cotizaciones.
    // Cada línea de la compra trae su valor total (un número de 0 en adelante: un texto da error y niega); el valor de la compra no puede ser
    // menor que la suma (máximo 5 líneas). Las listas se leen una sola vez y se pasan a cada función: así se gastan menos expresiones.
    function valorLinea(ls, i) { return ls.size() > i ? ls[i].valor : 0; }
    function lineaOk(ls, i) { return ls.size() <= i || ls[i].valor >= 0; }
    function sumaLineas(ls) { return valorLinea(ls, 0) + valorLinea(ls, 1) + valorLinea(ls, 2) + valorLinea(ls, 3) + valorLinea(ls, 4); }
    // Cada cotización es una foto JPEG pequeña (como las que arma la app), no cualquier texto.
    function cotOk(c, i) {
      return c.size() <= i || (c[i] is string && c[i].size() < 200000 && c[i].matches('^data:image/jpeg;base64,.*'));
    }
    function pedidoOk() {
      let ls = nuevo().get('lineas', []);
      let c = nuevo().get('cotizaciones', []);
      return nuevo().get('pideUid', request.auth.uid) == request.auth.uid
        && nuevo().get('pideCorreo', '') == request.auth.token.email && nuevo().get('creadoEn', null) == request.time
        && nuevo().valorAprox is number && nuevo().valorAprox >= 0
        && ls is list && ls.size() <= 5
        && nuevo().valorAprox >= sumaLineas(ls)
        && c is list && c.size() <= 3
        && lineaOk(ls, 0) && lineaOk(ls, 1) && lineaOk(ls, 2) && lineaOk(ls, 3) && lineaOk(ls, 4)
        && cotOk(c, 0) && cotOk(c, 1) && cotOk(c, 2);
    }
    function veVehiculos() { return esDemo() && nivel('vehiculos') != 'no'; }
    function veReuniones() { return esDemo() && nivel('reuniones') != 'no'; }
    // En Reuniones, «solo ver» y «sin acceso» no actúan.
    function actuaReu() { return esDemo() && !(nivel('reuniones') in ['no', 'ver']); }
    // Administrativa con el permiso extra «encargada»: ve todo lo de las reuniones y la bandeja de correos.
    function esEncargada() { return esDemo() && rol() == 'administrativo' && tieneExtra('encargada'); }
    function esBodega() { return esDemo() && nivel('inventario') in ['bodega', 'jefe']; }
    function nuevo() { return request.resource.data; }
    function antes() { return resource.data; }
    function soloCambia(campos) { return nuevo().diff(antes()).affectedKeys().hasOnly(campos); }

    // Marca de los datos de prueba: solo la Jefe los carga o reinicia.
    match /demo/{id} {
      allow read: if esDemo();
      allow write: if esJefe();
    }

    // Módulos que en esta fase solo se ven: los escribe la Jefe al cargar los datos de prueba.
    // ---------- EQUIPOS (Equipos y Entregas juntas, con el acta virtual) ----------
    function veEquipos() { return esDemo() && nivel('equipos') != 'no'; }
    function esEncargadoEq() { return esDemo() && nivel('equipos') in ['encargado', 'jefe']; }
    function revisaActas() { return esJefe() || (esDemo() && nivel('equipos') == 'soporte' && tieneExtra('actas')); }
    function firmaOk(f) { return f is string && f.size() < 80000 && f.matches('^data:image/png;base64,.*'); }
    // El historial del equipo solo crece: una línea nueva al final y las viejas iguales.
    function historialEqSigue() {
      return nuevo().historial is list && nuevo().historial.size() == antes().get('historial', []).size() + 1
        && nuevo().historial[0:antes().get('historial', []).size()] == antes().get('historial', []);
    }
    function rutaHoja(h) { return /databases/$(database)/documents/hojas/$(h); }
    function ultimoPaso() { return nuevo().historial[nuevo().historial.size() - 1]; }
    // Datos de compra y garantía (opcionales): fechas vacías o AAAA-MM-DD, proveedor corto y costo en pesos.
    function fechaOpc(f) { return f == '' || esFecha(f); }
    function compraEqOk() {
      let fc = nuevo().get('fechaCompra', ''); let gh = nuevo().get('garantiaHasta', ''); let pv = nuevo().get('proveedor', ''); let co = nuevo().get('costo', 0);
      return fc is string && fechaOpc(fc) && gh is string && fechaOpc(gh) && pv is string && pv.size() <= 60 && co is number && co >= 0 && co <= 1000000000;
    }
    // La baja de un equipo: motivo, nota y quién la pidió. Solo equipos que están en bodega o en Recibidos (uno asignado se recibe primero).
    function bajaOk(b) {
      return b is map && b.keys().hasOnly(['motivo', 'nota', 'por', 'porRol', 'en']) && b.motivo in ['danado', 'robado', 'perdido', 'obsoleto']
        && b.nota is string && b.nota.size() >= 5 && b.nota.size() <= 200 && b.por is string && b.porRol is string && esFecha(b.en);
    }
    match /equipos/{id} {
      allow read: if veEquipos();
      allow delete: if esJefe();
      allow create: if (esPrueba() && esJefe()) || (id.matches('^eq-[a-z0-9]{4,30}$') && nuevo().estado == 'bodega' && nuevo().serial is string && nuevo().serial.size() <= 30
        && nuevo().historial.size() == 1 && compraEqOk() && esEncargadoEq());
      // El Encargado entrega, recibe, hace mantenimiento y backup (siempre con una línea de historial) y anota los datos de compra y garantía.
      // Entregar o recibir (pasar a «asignado» o «recibido») solo junto con el acta en esa misma escritura. Un equipo de baja ya no se mueve.
      // Primero van las condiciones baratas (qué campos cambian y a qué estado) y al final quién es la persona: así cada rama falla rápido
      // y el límite de 1000 expresiones de las reglas alcanza hasta para la Jefe (que pasa por varias ramas).
      allow update: if (esPrueba() && esJefe())
        || (soloCambia(['estado', 'asignadoA', 'asignadoCedula', 'proyecto', 'ultimoMtto', 'ultimoBackup', 'obs', 'pendientes', 'historial', 'fechaCompra', 'garantiaHasta', 'proveedor', 'costo'])
            && antes().estado != 'baja' && nuevo().estado in ['asignado', 'bodega', 'recibido']
            && (nuevo().estado != 'asignado' || antes().get('bajaPedida', null) == null) && esEncargadoEq() && historialEqSigue() && compraEqOk()
            && (nuevo().estado == antes().estado || nuevo().estado == 'bodega'
                || (ultimoPaso().hojaId is string && existsAfter(rutaHoja(ultimoPaso().hojaId))
                    && ultimoPaso().tipo == (nuevo().estado == 'asignado' ? 'entrega' : 'devolucion'))))
        // Pedir la baja: el Encargado deja la solicitud (con su línea de historial) y el equipo sigue donde está hasta que la Jefe decida.
        || (soloCambia(['bajaPedida', 'historial']) && antes().estado in ['bodega', 'recibido'] && antes().get('bajaPedida', null) == null && nuevo().bajaPedida != null
            && bajaOk(nuevo().bajaPedida) && nuevo().bajaPedida.porRol == rol() && historialEqSigue() && esEncargadoEq())
        // Solo la Jefe da de baja: aprueba lo pedido (sin cambiarlo) o la hace directa. El equipo pasa a «baja» con la fecha y quién la aprobó.
        || (soloCambia(['estado', 'bajaPedida', 'bajaPor', 'bajaEn', 'historial']) && nuevo().estado == 'baja' && antes().estado in ['bodega', 'recibido']
            && bajaOk(nuevo().bajaPedida) && nuevo().bajaPedida == antes().get('bajaPedida', nuevo().bajaPedida)
            && (antes().get('bajaPedida', null) != null || nuevo().bajaPedida.porRol == rol()) && nuevo().bajaPor is string && esFecha(nuevo().bajaEn)
            && historialEqSigue() && esJefe())
        // La Jefe también puede no aprobar lo pedido: la solicitud se quita y el equipo sigue igual.
        || (soloCambia(['bajaPedida', 'historial']) && nuevo().bajaPedida == null && antes().estado in ['bodega', 'recibido'] && antes().get('bajaPedida', null) != null
            && historialEqSigue() && esJefe())
        // Verificar (contar y escanear): Soporte y la Jefe dejan la fecha y quién lo verificó, sin tocar nada más.
        || (soloCambia(['verificadoEn', 'verificadoPor']) && antes().estado != 'baja' && esFecha(nuevo().verificadoEn) && nuevo().verificadoPor is string
            && nuevo().verificadoPor.size() <= 80 && (esJefe() || (esDemo() && nivel('equipos') == 'soporte')));
    }
    // Actas (como la hoja de papel): las crea el Encargado con la firma de quien recibe; el id es «ac» + el número,
    // así dos actas no quedan con el mismo número. La devolución se agrega a la misma acta (con su firma).
    // Soporte (con el permiso de actas) las revisa, pero nadie revisa las suyas. Si tienen un problema, el Encargado
    // las corrige y vuelven a revisión. No se borran (solo la Jefe).
    match /hojas/{id} {
      allow read: if veEquipos();
      allow delete: if esJefe();
      allow create: if (esPrueba() && esJefe()) || (esEncargadoEq()
        && nuevo().numero is int && id == 'ac' + string(nuevo().numero)
        && nuevo().porRol == rol() && nuevo().revision == 'pendiente' && nuevo().devoluciones == []
        && nuevo().persona is string && nuevo().persona.size() >= 5 && nuevo().persona.size() <= 80
        && nuevo().cedula is string && nuevo().cedula.matches('^[0-9]{5,12}$')
        && nuevo().equipos is list && nuevo().equipos.size() >= 1 && nuevo().equipos.size() <= 20
        && nuevo().otros is list && nuevo().otros.size() <= 30
        && firmaOk(nuevo().firmaPersona) && !nuevo().keys().hasAny(['foto']));
      allow update: if (esPrueba() && esJefe())
        || (revisaActas() && antes().revision == 'pendiente' && antes().porRol != rol() && nuevo().revision in ['ok', 'problema']
            && soloCambia(['revision', 'revisadaPor', 'revisadaEn', 'notaRevision']))
        || (esEncargadoEq() && antes().revision == 'problema' && nuevo().revision == 'pendiente'
            && soloCambia(['persona', 'cedula', 'proyecto', 'codigoProyecto', 'firmaPersona', 'revision', 'revisadaPor', 'revisadaEn'])
            && nuevo().persona is string && nuevo().persona.size() >= 5 && nuevo().persona.size() <= 80
            && nuevo().cedula is string && nuevo().cedula.matches('^[0-9]{5,12}$') && firmaOk(nuevo().firmaPersona))
        // Devolución: una más al final (las anteriores iguales), con su firma; el acta vuelve a revisión.
        || (esEncargadoEq() && nuevo().revision == 'pendiente'
            && soloCambia(['devoluciones', 'revision', 'revisadaPor', 'revisadaEn', 'notaRevision'])
            && nuevo().devoluciones is list && nuevo().devoluciones.size() == antes().get('devoluciones', []).size() + 1
            && nuevo().devoluciones[0:antes().get('devoluciones', []).size()] == antes().get('devoluciones', [])
            && firmaOk(nuevo().devoluciones[nuevo().devoluciones.size() - 1].firma));
    }
    // Agenda: Soporte o la Jefe le programan tareas al Encargado; él las marca hechas.
    match /tareasEq/{id} {
      allow read: if veEquipos();
      allow delete: if esJefe();
      allow create: if (esPrueba() && esJefe()) || (esDemo() && nivel('equipos') in ['soporte', 'jefe'] && nuevo().pidioRol == rol()
        && nuevo().estado == 'pendiente' && nuevo().tipo in ['mantenimiento', 'backup', 'revision']);
      allow update: if (esPrueba() && esJefe()) || (esEncargadoEq() && antes().estado == 'pendiente' && nuevo().estado == 'hecha'
        && soloCambia(['estado', 'hechaPor', 'hechaEn', 'resultado']));
    }

    // Vehículos: hoja de vida de cada carro. Transporte y Bodega asignan, actualizan documentos y estado;
    // el Conductor solo cambia estado (salida/llegada), kilometraje (nunca hacia atrás) y conductor, con una línea de historial.
    // El plan de mantenimiento de un carro (`mttos`) es una lista de hasta 10 tareas: { id, tarea, cadaKm, cadaDias, ultimoKm, ultimaFecha, ultimoCosto }.
    // Lo cambian Transporte y Bodega (siempre con una línea nueva de historial) y la Jefe; el Conductor no.
    // Cada tarea trae sus «cada cuántos km / días» como números de 0 en adelante (se mira una por una, hasta 10). Comparar un texto con un número da error
    // en las reglas, y un error aquí niega la escritura: por eso basta con «>= 0» (y gasta menos de las 1000 expresiones que permite Firebase).
    function mttoOk(l, i) { return l.size() <= i || (l[i].cadaKm >= 0 && l[i].cadaDias >= 0); }
    function mttosOk() {
      let l = nuevo().get('mttos', []);
      return l is list && l.size() <= 10 && mttoOk(l, 0) && mttoOk(l, 1) && mttoOk(l, 2) && mttoOk(l, 3) && mttoOk(l, 4) && mttoOk(l, 5) && mttoOk(l, 6) && mttoOk(l, 7) && mttoOk(l, 8) && mttoOk(l, 9);
    }
    match /vehiculos/{id} {
      allow read: if veVehiculos();
      allow create, delete: if esJefe();
      allow update: if (esJefe() && mttosOk())
        || (esDemo() && nivel('vehiculos') == 'autoriza' && soloCambia(['conductor', 'soat', 'tecno', 'estado', 'km', 'historial', 'ultimaEntrega', 'mttos'])
            && nuevo().km is number && nuevo().km >= antes().km && nuevo().estado in ['disponible', 'en-uso', 'en-taller']
            && esFecha(nuevo().soat) && esFecha(nuevo().tecno) && historialSigue() && mttosOk())
        // El Conductor solo pasa el carro de disponible a en uso (o al revés) junto con la salida o llegada que registra en ese mismo momento.
        || (esDemo() && nivel('vehiculos') == 'reporta' && soloCambia(['estado', 'km', 'conductor', 'historial', 'ultimaEntrega'])
            && antes().estado in ['disponible', 'en-uso'] && nuevo().estado in ['disponible', 'en-uso'] && nuevo().estado != antes().estado
            && nuevo().km is number && nuevo().km >= antes().km && nuevo().km <= antes().km + 3000 && historialSigue()
            && nuevo().ultimaEntrega is string && !exists(rutaEnt(nuevo().ultimaEntrega))
            && getAfter(rutaEnt(nuevo().ultimaEntrega)).data.vehiculoId == id
            && getAfter(rutaEnt(nuevo().ultimaEntrega)).data.km == nuevo().km
            && getAfter(rutaEnt(nuevo().ultimaEntrega)).data.tipo == (nuevo().estado == 'en-uso' ? 'salida' : 'llegada'));
    }

    // Novedades de un carro: siempre con foto, sin revisar al nacer. Las revisan Transporte, Bodega o la Jefe.
    match /novedades/{id} {
      allow read: if veVehiculos();
      // La Jefe de prueba las crea al cargar los datos de ejemplo.
      allow create: if (esPrueba() && esJefe()) || (esDemo() && nivel('vehiculos') in ['reporta', 'autoriza', 'jefe']
        && nuevo().keys().hasOnly(['vehiculoId', 'placa', 'tipo', 'fecha', 'km', 'descripcion', 'foto', 'reporta', 'reportaRol', 'costo', 'revisada', 'revisadaPor', 'revisadaEn', 'nota'])
        && nuevo().reportaRol == rol() && nuevo().revisada == false
        && nuevo().tipo in ['llanta', 'choque', 'rayon', 'mantenimiento', 'otro']
        && nuevo().foto is string && nuevo().foto.size() < 400000 && nuevo().foto.matches('^data:image/jpeg;base64,.*')
        && nuevo().costo is number && (nuevo().costo == 0 || nivel('vehiculos') != 'reporta'));
      // La Jefe de prueba la reescribe al cargar o reiniciar los datos de ejemplo.
      allow update: if (esPrueba() && esJefe()) || (esJefe() || (esDemo() && nivel('vehiculos') == 'autoriza'))
        && soloCambia(['costo', 'revisada', 'revisadaPor', 'revisadaEn', 'nota']) && nuevo().costo is number && nuevo().costo >= 0
        && antes().revisada == false && nuevo().revisada == true && nuevo().get('nota', '').size() <= 160;
      allow delete: if esJefe();
    }

    // Salidas y llegadas de los carros: con las 5 fotos (cada una pequeña) y la revisión. No se cambian después.
    // Si la salida o la llegada es de una reserva (reservaId), esa reserva tiene que estar aprobada y ser de ese mismo carro.
    function reservaDeEntregaOk() {
      let r = nuevo().get('reservaId', '');
      return r is string && (r == '' || (exists(rutaRes(r)) && get(rutaRes(r)).data.estado == 'aprobada' && get(rutaRes(r)).data.vehiculoId == nuevo().vehiculoId));
    }
    // Una SALIDA lleva marcados en «Bien» los 4 puntos críticos de la revisión (frenos, llantas, luces y dirección): con uno mal el carro no sale.
    function salidaOk() {
      let r = nuevo().get('revision', {});
      return nuevo().tipo == 'llegada' || (r.get('frenos', false) == true && r.get('llantas', false) == true && r.get('luces', false) == true && r.get('direccion', false) == true);
    }
    match /entregas/{id} {
      allow read: if veVehiculos();
      allow create: if (esPrueba() && esJefe()) || (esDemo() && nivel('vehiculos') in ['reporta', 'autoriza', 'jefe']
        && nuevo().porRol == rol() && nuevo().tipo in ['salida', 'llegada'] && salidaOk() && reservaDeEntregaOk()
        && nuevo().fotos.keys().hasOnly(['frente', 'atras', 'izquierda', 'derecha', 'llantas'])
        && nuevo().fotos.keys().hasAll(['frente', 'atras', 'izquierda', 'derecha', 'llantas'])
        && nuevo().fotos.frente is string && nuevo().fotos.frente.size() < 200000
        && nuevo().fotos.atras is string && nuevo().fotos.atras.size() < 200000
        && nuevo().fotos.izquierda is string && nuevo().fotos.izquierda.size() < 200000
        && nuevo().fotos.derecha is string && nuevo().fotos.derecha.size() < 200000
        && nuevo().fotos.llantas is string && nuevo().fotos.llantas.size() < 200000);
      allow update, delete: if esJefe();
    }

    // Tanqueos: cada vez que un carro echa combustible, con la foto del recibo (JPEG pequeña). Los crean el Conductor, Transporte, Bodega y
    // la Jefe a su nombre, para un carro que existe (con la placa de ese carro y la fecha como la de la app: AAAA-MM-DD o con hora). No se cambian ni se borran después (solo la Jefe). Con ellos se calcula cuántos km
    // rinde cada carro y cuánto cuesta. La Jefe de prueba los carga y reinicia con los datos de ejemplo.
    match /tanqueos/{id} {
      allow read: if veVehiculos();
      allow create: if (esPrueba() && esJefe()) || (esDemo() && nivel('vehiculos') in ['reporta', 'autoriza', 'jefe']
        && nuevo().keys().hasOnly(['vehiculoId', 'placa', 'fecha', 'km', 'galones', 'valor', 'lleno', 'foto', 'por', 'porRol'])
        && nuevo().vehiculoId is string && nuevo().placa is string && get(/databases/$(database)/documents/vehiculos/$(nuevo().vehiculoId)).data.placa == nuevo().placa
        && nuevo().fecha is string && nuevo().fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$') && nuevo().por is string && nuevo().por.size() <= 80 && nuevo().porRol == rol()
        && nuevo().km is number && nuevo().km >= 0 && nuevo().galones is number && nuevo().galones > 0 && nuevo().galones <= 100
        && nuevo().valor is number && nuevo().valor > 0 && nuevo().valor <= 5000000 && nuevo().lleno is bool
        && nuevo().foto is string && nuevo().foto.size() < 400000 && nuevo().foto.matches('^data:image/jpeg;base64,.*'));
      allow update, delete: if esJefe();
    }

    // Reservas de carro para un viaje que no es una reunión. Pasos: pedida -> aprobada (con el carro y el conductor) o rechazada; una pedida o aprobada se puede cancelar.
    //   Las pide quien tenga nivel de trabajo en Vehículos, a su nombre y con su correo (el del token). Las aprueban o rechazan Transporte, Bodega o la Jefe, nunca quien la pidió.
    //   Al aprobar, el carro tiene que existir, no estar en el taller y tener el SOAT y la técnico-mecánica vigentes ese día. (Que no haya otra reserva ni reunión con ese carro
    //   el mismo día lo revisa la app: las reglas no pueden contar documentos.) La Jefe de prueba las carga y reinicia con los datos de ejemplo.
    function pideVeh() { return esDemo() && nivel('vehiculos') in ['reporta', 'autoriza', 'jefe']; }
    function adminVeh() { return esJefe() || (esDemo() && nivel('vehiculos') == 'autoriza'); }
    function rutaVeh(v) { return /databases/$(database)/documents/vehiculos/$(v); }
    function rutaRes(r) { return /databases/$(database)/documents/reservas/$(r); }
    function carroLibreOk(fecha) {
      let v = get(rutaVeh(nuevo().vehiculoId)).data;
      return v.placa == nuevo().placa && v.estado != 'en-taller' && v.soat >= fecha && v.tecno >= fecha;
    }
    function apruebaOk() {
      return nuevo().vehiculoId is string && nuevo().placa is string && exists(rutaVeh(nuevo().vehiculoId)) && carroLibreOk(antes().fecha)
        && nuevo().conductor is string && nuevo().conductor.size() >= 3 && nuevo().conductor.size() <= 60
        && nuevo().decidePor is string && esFecha(nuevo().decideEn) && nuevo().decideCorreo == request.auth.token.email;
    }
    function rechazaOk() {
      return nuevo().motivoRechazo is string && nuevo().motivoRechazo.size() >= 3 && nuevo().motivoRechazo.size() <= 140
        && nuevo().decidePor is string && esFecha(nuevo().decideEn) && nuevo().decideCorreo == request.auth.token.email;
    }
    function noEsMia() { return antes().get('pideCorreo', '') != request.auth.token.email; }
    match /reservas/{id} {
      allow read: if veVehiculos();
      allow create: if (esPrueba() && esJefe())
        || (id.matches('^rs-[a-z0-9]{4,30}$') && nuevo().estado == 'pedida'
            && nuevo().keys().hasOnly(['fecha', 'hora', 'destino', 'motivo', 'estado', 'por', 'porRol', 'pideCorreo', 'en'])
            && esFecha(nuevo().fecha) && esFecha(nuevo().en) && nuevo().hora is string && nuevo().hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && nuevo().destino is string && nuevo().destino.size() >= 3 && nuevo().destino.size() <= 80
            && nuevo().motivo is string && nuevo().motivo.size() >= 3 && nuevo().motivo.size() <= 140
            && nuevo().por is string && nuevo().porRol == rol() && nuevo().pideCorreo == request.auth.token.email && pideVeh());
      allow update: if (esPrueba() && esJefe())
        || (antes().estado == 'pedida' && nuevo().estado == 'aprobada' && soloCambia(['estado', 'vehiculoId', 'placa', 'conductor', 'decidePor', 'decideCorreo', 'decideEn']) && noEsMia() && apruebaOk() && adminVeh())
        || (antes().estado == 'pedida' && nuevo().estado == 'rechazada' && soloCambia(['estado', 'motivoRechazo', 'decidePor', 'decideCorreo', 'decideEn']) && noEsMia() && rechazaOk() && adminVeh())
        || (nuevo().estado == 'cancelada' && antes().estado in ['pedida', 'aprobada'] && soloCambia(['estado', 'canceladaPor', 'canceladaEn']) && nuevo().canceladaPor is string && esFecha(nuevo().canceladaEn)
            && ((antes().estado == 'pedida' && !noEsMia() && pideVeh()) || adminVeh()));
      allow delete: if esJefe();
    }

    // Reuniones: las arma la Jefe con lo que entendió el agente. Administrativo la marca como realizada al registrar el acta.
    // Ajustes que se escriben solo a mano en la consola de Firebase. ajustes/buzon = { uid: <UID de la cuenta robot> }.
    match /ajustes/{id} {
      allow read, write: if false;
    }
    function rutaAjusteBuzon() { return /databases/$(database)/documents/ajustes/buzon; }
    // La cuenta robot del buzón: su UID tiene que ser el que Jeiler guardó a mano en ajustes/buzon
    // (así nadie se hace pasar por ella aunque se registre primero con ese correo).
    function esRobotBuzon() {
      return request.auth != null && request.auth.token.email == 'buzon.demo@example.com'
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(rutaAjusteBuzon()) && request.auth.uid == get(rutaAjusteBuzon()).data.uid;
    }
    // Bandeja de correos: los correos que llegan al Gmail de prueba. Los sube un Apps Script con la cuenta robot
    // (solo puede crear aquí: no tiene perfil ni rol, así que no ve ni toca nada más).
    // Los leen la Jefe y la Administrativa encargada; la Jefe los reparte con el agente o los borra.
    match /buzon/{id} {
      allow read: if esJefe() || esEncargada();
      allow create: if esRobotBuzon()
        && id.size() <= 40 && nuevo().keys().hasOnly(['asunto', 'texto', 'fecha'])
        && nuevo().asunto is string && nuevo().asunto.size() <= 300
        && nuevo().texto is string && nuevo().texto.size() >= 10 && nuevo().texto.size() <= 8000
        && nuevo().fecha is string && nuevo().fecha.size() <= 40;
      allow update: if false;
      allow delete: if esJefe();
    }

    match /reuniones/{id} {
      allow read: if veReuniones();
      allow create, delete: if esJefe();
      // Administrativo: solo en la misma escritura que guarda el acta de ESA reunión, el día de la reunión o después,
      // y agregando una sola línea al historial.
      allow update: if esJefe()
        || (actuaReu() && rol() == 'administrativo' && antes().estado in ['programada', 'reprogramada']
            && nuevo().estado == 'realizada' && soloCambia(['estado', 'historial', 'actaId']) && yaFue(antes().fecha)
            && nuevo().historial.size() == antes().get('historial', []).size() + 1
            && get(rutaNec(nuevo().actaId)).data.estado == 'pendiente'
            && getAfter(rutaNec(nuevo().actaId)).data.tipo == 'acta'
            && getAfter(rutaNec(nuevo().actaId)).data.reunionId == id
            && getAfter(rutaNec(nuevo().actaId)).data.estado == 'listo');
    }

    // Lo que le toca a cada rol en una reunión (una tarea por documento). Cada quien cambia solo la suya,
    // sin tocar de qué reunión es, qué es ni a quién le toca. La asistencia y el viaje son POR PERSONA: llevan su correo
    // (responsableCorreo) y solo esa persona los decide; las tareas viejas sin correo las decide cualquiera de ese rol.
    function actualizaNec(id) {
      let r = rol();
      return (antes().responsableRol == r && antes().estado == 'pendiente'
            && antes().get('responsableCorreo', request.auth.token.email) == request.auth.token.email
            && soloCambia(['estado', 'por', 'en', 'motivo', 'conductor', 'items', 'acta'])
            && nuevo().estado in estadosDe(antes().tipo)
            && (antes().tipo != 'acta' || yaFue(antes().fechaReunion)))
        // Compras, Transporte y Bodega agregan lo que hay (un informe a la vez, sin tocar los de los demás) para que la Jefe decida.
        || (r in informanEn(antes().tipo) && antes().estado == 'pendiente' && soloCambia(['informes'])
            && nuevo().informes is list && nuevo().informes.size() == antes().get('informes', []).size() + 1 && nuevo().informes.size() <= 20
            && nuevo().informes == antes().get('informes', []).concat([nuevo().informes[nuevo().informes.size() - 1]])
            && nuevo().informes[nuevo().informes.size() - 1].rol == r
            && nuevo().informes[nuevo().informes.size() - 1].texto is string
            && nuevo().informes[nuevo().informes.size() - 1].texto.size() <= 200)
        // El conductor que no puede devuelve los carros para que la Jefe escoja otro.
        //   Tiene que decir cuál de sus viajes deja (y ese viaje queda en «no-va» en la misma escritura, que solo puede hacer su dueño).
        || (r == 'conductor' && antes().tipo == 'carros' && antes().estado == 'autorizado'
            && nuevo().estado == 'pendiente' && nuevo().conductor == '' && soloCambia(['estado', 'conductor', 'motivo', 'devuelto'])
            && nuevo().devuelto is string && get(rutaNec(nuevo().devuelto)).data.tipo == 'viaje'
            && get(rutaNec(nuevo().devuelto)).data.estado in ['pendiente', 'listo']
            && getAfter(rutaNec(nuevo().devuelto)).data.carrosId == id
            && getAfter(rutaNec(nuevo().devuelto)).data.estado == 'no-va');
    }
    match /necesidades/{id} {
      allow read: if veReuniones();
      // Las crea la Jefe (también el viaje del conductor, al autorizar los carros).
      allow create: if esJefe();
      // Cada quien decide SU tarea una vez (mientras está pendiente). El acta, el día de la reunión o después.
      // (Quién es la persona y su rol se miran una sola vez, en actualizaNec(): así no se pasa del límite de expresiones.)
      allow update: if esJefe() || (actuaReu() && actualizaNec(id));
      allow delete: if esJefe();
    }

    // Bodega: artículos y movimientos. Cada cambio de cantidad deja su movimiento en la MISMA escritura: el artículo apunta a su
    // movimiento nuevo (ultimoMov), que no existía antes, es de ese artículo y trae la diferencia exacta (entrada y ajuste suman su
    // cantidad; salida resta). Lo mismo si cambia el costo (que es el costo promedio): lleva un ajuste de cantidad 0. Así no se cambia el stock ni el costo sin dejar rastro. La Jefe de prueba carga y reinicia los datos de ejemplo.
    function rutaMov(m) { return /databases/$(database)/documents/movimientos/$(m); }
    function rutaArt(a) { return /databases/$(database)/documents/articulos/$(a); }
    function movOk(artId, cantAntes) {
      return nuevo().get('ultimoMov', null) is string && !exists(rutaMov(nuevo().ultimoMov))
        && getAfter(rutaMov(nuevo().ultimoMov)).data.articuloId == artId
        && nuevo().cantidad - cantAntes == (getAfter(rutaMov(nuevo().ultimoMov)).data.tipo == 'salida' ? 0 - getAfter(rutaMov(nuevo().ultimoMov)).data.cantidad : getAfter(rutaMov(nuevo().ultimoMov)).data.cantidad);
    }
    // Las 3 bodegas de la empresa (deben coincidir con personas.js): todo artículo nace en una de ellas y no cambia de bodega
    // (para moverlo se hace un traslado: sale de una y entra a la otra, cada una con su movimiento).
    function bodegaOk() { return nuevo().get('bodega', '') in ['Riohacha', 'Guamal', 'Bogotá']; }
    // Código del artículo (opcional, en mayúsculas: 3 a 30 letras o números) y fecha de su último conteo (opcional).
    function codigoArtOk() { let c = nuevo().get('codigo', ''); return c is string && (c == '' || c.matches('^[A-Z0-9]{3,30}$')); }
    function conteoArtOk() { let f = nuevo().get('ultimoConteo', ''); return f is string && (f == '' || esFecha(f)); }
    match /articulos/{id} {
      allow read: if veInventario();
      // La cantidad nunca queda negativa (si dos personas sacan al tiempo lo último, la segunda recibe un error).
      allow create: if (esPrueba() && esJefe() && bodegaOk())
        || (esBodega() && bodegaOk() && codigoArtOk() && conteoArtOk() && nuevo().cantidad is number && nuevo().cantidad >= 0 && (nuevo().cantidad == 0 || movOk(id, 0)));
      allow update: if (esPrueba() && esJefe())
        || (esBodega() && soloCambia(['cantidad', 'ultimoMov', 'nombre', 'categoria', 'unidad', 'minimo', 'maximo', 'ubicacion', 'costo', 'proveedor', 'codigo', 'ultimoConteo'])
            && codigoArtOk() && conteoArtOk() && nuevo().cantidad is number && nuevo().cantidad >= 0 && nuevo().get('costo', 0) is number && nuevo().get('costo', 0) >= 0
            && ((nuevo().cantidad == antes().cantidad && nuevo().get('costo', 0) == antes().get('costo', 0)) || movOk(id, antes().cantidad)));
      allow delete: if esJefe();
    }
    match /movimientos/{id} {
      allow read: if veMovimientos();
      // Un movimiento nace solo junto con el cambio de su artículo (el artículo apunta a él con ultimoMov). Entradas y salidas llevan una
      // cantidad mayor que 0 (un ajuste puede ser negativo o 0), y el costo y el valor, si vienen, son números de 0 en adelante.
      allow create: if (esPrueba() && esJefe())
        || (esBodega() && nuevo().por is string && nuevo().porRol == rol() && nuevo().tipo in ['entrada', 'salida', 'ajuste'] && nuevo().cantidad is number
            && (nuevo().tipo == 'ajuste' || nuevo().cantidad > 0)
            && nuevo().get('costoUnit', 0) is number && nuevo().get('costoUnit', 0) >= 0 && nuevo().get('valor', 0) is number && nuevo().get('valor', 0) >= 0
            && nuevo().articuloId is string && getAfter(rutaArt(nuevo().articuloId)).data.get('ultimoMov', '') == id);
      allow update, delete: if esPrueba() && rol() == 'jefe';
    }

    // Pedidos de material: cada quien pide a su nombre; la bodega los entrega o los cierra (solo toca el estado, quién entregó y el motivo).
    match /solicitudes/{id} {
      allow read: if veLoSuyo();
      allow create: if puedePedir() && (nuevo().pideRol == rol() || esJefe()) && (nuevo().estado == 'pendiente' || esJefe())
        && nuevo().get('pideUid', request.auth.uid) == request.auth.uid;
      allow update: if (esPrueba() && esJefe())
        || (antes().estado == 'pendiente' && nuevo().estado in ['entregada', 'rechazada'] && soloCambia(['estado', 'entregadaPor', 'fechaEntrega', 'motivo']) && esBodega());
      allow delete: if esJefe();
    }

    // Proveedores: nombre, NIT (opcional; la app revisa su dígito de verificación), contacto y una nota. Quién los ve: los que ven compras y bodega.
    // Los crean y editan Compras, la Jefe y Bodega con el extra «compra» (los mismos que registran compras). Solo la Jefe los borra.
    function veProveedores() { return esDemo() && nivel('inventario') in ['compra', 'coordina', 'bodega', 'jefe', 'finanzas', 'gerente']; }
    function rutaProv(p) { return /databases/$(database)/documents/proveedores/$(p); }
    function txtMax(c, max) { let v = nuevo().get(c, ''); return v is string && v.size() <= max; }
    function proveedorOk() {
      let n = nuevo().get('nombre', ''); let nit = nuevo().get('nit', ''); let co = nuevo().get('correo', '');
      return n is string && n.size() >= 2 && n.size() <= 80
        && nit is string && (nit == '' || nit.matches('^[0-9]{5,15}-[0-9]$'))
        && co is string && co.size() <= 80 && (co == '' || co.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && txtMax('contacto', 60) && txtMax('telefono', 25) && txtMax('nota', 200);
    }
    // El proveedor que se anota en una compra (opcional) tiene que existir cuando termina el lote (la app lo crea en la misma escritura si era nuevo).
    function proveedorIdOk() { let p = nuevo().get('proveedorId', ''); return p is string && (p == '' || (p.matches('^pv-[a-z0-9]{4,30}$') && existsAfter(rutaProv(p)))); }
    match /proveedores/{id} {
      allow read: if veProveedores();
      allow create: if (esPrueba() && esJefe())
        || (id.matches('^pv-[a-z0-9]{4,30}$') && nuevo().keys().hasOnly(['nombre', 'nit', 'contacto', 'telefono', 'correo', 'nota', 'por', 'porRol', 'en'])
            && nuevo().get('por', 0) is string && nuevo().get('porRol', '') == rol() && esFecha(nuevo().get('en', '')) && proveedorOk() && esCompras());
      allow update: if (esPrueba() && esJefe())
        || (soloCambia(['nombre', 'nit', 'contacto', 'telefono', 'correo', 'nota']) && proveedorOk() && esCompras());
      allow delete: if esJefe();
    }

    // Compras. Pasos: pedido -> autorizado (o rechazado) -> comprado -> recibido.
    //   Quién autoriza: lo autoriza la Coordinadora de compras (ya no la Jefe). Si vale MÁS del monto del Gerente
    //   (ajustesApp/compras.montoGerente, por defecto 5.000.000), queda «por-gerente» y lo autoriza después el Gerente general.
    //   Lo que pide la Coordinadora lo decide siempre el Gerente general. Lo que pide el Gerente general nace autorizado.
    //   El Gerente general también puede decidir cualquier pedido (acceso total), menos uno suyo. Los demás Gerentes y la Jefe NO autorizan.
    //   Cada compra guarda el correo de quien la pidió y la hora del servidor (pideCorreo, creadoEn): no se pueden inventar.
    //   Cada paso revisa primero el estado (lo barato) para no pasarse del límite de expresiones de las reglas.
    function rutaMonto() { return /databases/$(database)/documents/ajustesApp/compras; }
    function montoGerente() { return exists(rutaMonto()) ? get(rutaMonto()).data.get('montoGerente', 5000000) : 5000000; }
    // Quien decide deja su correo (el del token): el nombre que escribe no se puede usar para hacerse pasar por otra persona.
    function decideCampos() { return soloCambia(['estado', 'autoriza', 'autorizaCorreo', 'autorizaJefe', 'motivoRechazo', 'historial']) && nuevo().autorizaCorreo == request.auth.token.email && historialSigue(); }
    // Quién decide un pedido que todavía no tiene respuesta (antes().estado == 'pedido'). Nadie decide lo suyo.
    function decidePedido() {
      return antes().get('pideRol', '') == 'coordcompras' ? esGerenteGeneral() && antes().get('pideCorreo', '') != request.auth.token.email && nuevo().estado in ['autorizado', 'rechazado']
        : (esCoordinador() && antes().get('pideCorreo', '') != request.auth.token.email && (nuevo().estado == 'rechazado' || nuevo().estado == (antes().valorAprox > montoGerente() ? 'por-gerente' : 'autorizado')))
          || (esGerenteGeneral() && antes().get('pideCorreo', '') != request.auth.token.email && nuevo().estado in ['autorizado', 'rechazado']);
    }
    match /compras/{id} {
      allow read: if veLoSuyo();
      // Pedir: a su propio nombre y en estado "pedido" (también el Gerente: otro Gerente la decide). Compras también registra
      // compras hechas sin autorización (nacen sin revisar). La Jefe de prueba crea cualquier compra porque carga y reinicia los datos de ejemplo.
      allow create: if (esPrueba() && esJefe())
        || (nuevo().estado == 'pedido' && nuevo().pideRol == rol() && puedePedir() && pedidoOk())
        || (nuevo().estado == 'sin-autorizar' && nuevo().revisada == false && proveedorIdOk() && esCompras() && pedidoOk())
        // El Gerente general pide una compra y nace autorizada (nadie autoriza lo suyo ni lo de él).
        || (nuevo().estado == 'autorizado' && nuevo().pideRol == 'gerente' && esGerenteGeneral() && puedePedir() && pedidoOk() && nuevo().autorizaCorreo == request.auth.token.email);
      allow update:
        // La Jefe de prueba puede todo (reinicia los datos de ejemplo).
        if (esPrueba() && rol() == 'jefe')
        // Decidir un pedido (rechazar, autorizar o pasarlo al Gerente según quién lo pidió y el monto).
        || (antes().estado == 'pedido' && nuevo().estado in ['autorizado', 'por-gerente', 'rechazado'] && decideCampos() && decidePedido())
        // El Gerente general decide lo que la Coordinadora le pasó por el monto.
        || (antes().estado == 'por-gerente' && nuevo().estado in ['autorizado', 'rechazado'] && decideCampos() && nuevo().get('autorizaJefe', '') == antes().get('autorizaJefe', '') && esGerenteGeneral())
        // Comprar (autorizada -> comprada): Compras, sin tocar lo autorizado. Lo pagado no pasa de 1,5 veces lo autorizado (si no tenía valor, del monto del
        // Gerente): más que eso necesita una autorización nueva. Entre 10 % y 50 % más, la app deja el aviso y la nota en el historial.
        || (antes().estado == 'autorizado' && nuevo().estado == 'comprado' && soloCambia(['estado', 'proveedor', 'proveedorId', 'valorReal', 'fechaCompra', 'factura', 'historial']) && historialSigue() && proveedorIdOk()
            && nuevo().valorReal is number && nuevo().valorReal >= 0 && nuevo().valorReal <= (antes().valorAprox > 0 ? antes().valorAprox * 1.5 : montoGerente()) && esCompras())
        // Recibir (comprada -> recibida): la bodega.
        || (antes().estado == 'comprado' && nuevo().estado == 'recibido' && soloCambia(['estado', 'entregadoA', 'historial']) && historialSigue() && esBodega())
        // La Coordinadora (o el Gerente general) marca como revisada una compra hecha sin autorización.
        || (antes().estado == 'sin-autorizar' && antes().revisada == false && nuevo().revisada == true && soloCambia(['revisada', 'revisadaPorCorreo', 'historial']) && nuevo().revisadaPorCorreo == request.auth.token.email && historialSigue() && (esCoordinador() || esGerenteGeneral()));
      // Las compras no se borran (son el rastro de lo que se gastó); solo la Jefe de prueba, al reiniciar los datos de ejemplo.
      allow delete: if esPrueba() && rol() == 'jefe';
    }

    // Ajustes de la app (distintos de «ajustes», que solo se escriben a mano en la consola).
    //   compras.montoGerente: por encima de ese valor, el Gerente general también autoriza. Solo lo cambia el Gerente general (cuenta propia), así la Jefe no puede subirlo.
    //   seguridad.personasPrueba: la Jefe (cuenta propia) lo pone en false para apagar las personas de prueba (clave pública).
    match /ajustesApp/{id} {
      allow read: if esDemo();
      allow write: if (id == 'compras' && esCuentaDe(['gerente']) && tieneExtra('general') && nuevo().keys().hasOnly(['montoGerente'])
          && nuevo().montoGerente is int && nuevo().montoGerente >= 0 && nuevo().montoGerente <= 1000000000)
        || (id == 'seguridad' && esCuentaDe(['jefe']) && nuevo().keys().hasOnly(['personasPrueba']) && nuevo().personasPrueba is bool);
    }

    // Invitaciones: la Jefe sube la lista (nombre, correo, rol y permisos) y cada persona entra con su correo confirmado.
    // El documento se llama como el correo (en minúscula). Sirven una sola vez: al crear su perfil la persona borra su invitación.
    function rutaInv(correo) { return /databases/$(database)/documents/invitaciones/$(correo); }
    match /invitaciones/{correo} {
      allow read: if esCuentaDe(['jefe'])
        || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == correo);
      allow create, update: if esCuentaDe(['jefe']) && correo.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$') && correo == correo.lower()
        && nuevo().keys().hasOnly(['nombre', 'rol', 'permisos', 'extras', 'por', 'en'])
        && nuevo().nombre is string && nuevo().nombre.size() >= 3 && nuevo().nombre.size() <= 60
        && nuevo().rol in ROLES() && !esDireccion(nuevo().rol) && permisosOk(nuevo().get('permisos', {}))
        && nuevo().get('extras', []) is list && nuevo().get('extras', []).size() <= 5
        && nuevo().get('extras', []).hasOnly(['compra', 'actas', 'encargada'])
        && nuevo().por is string && nuevo().en is string;
      allow delete: if esCuentaDe(['jefe'])
        || (request.auth != null && request.auth.token.email == correo && !exists(rutaPerfil()) && existsAfter(rutaPerfil()));
    }

    // Niveles por módulo que la Jefe puede dar (nunca «jefe» ni «gerente»). Reuniones: solo «sin acceso» o «solo ver»
    // (en Reuniones cada rol hace su tarea, por eso allí solo se sube o se baja a ver).
    function permisosOk(p) {
      return p is map && p.keys().hasOnly(['equipos', 'inventario', 'vehiculos', 'reuniones'])
        && p.get('equipos', 'ver') in ['no', 'ver', 'encargado', 'soporte']
        && p.get('inventario', 'ver') in ['no', 'ver', 'coordina', 'finanzas', 'pide', 'compra', 'bodega']
        && p.get('vehiculos', 'ver') in ['no', 'ver', 'reporta', 'autoriza']
        && p.get('reuniones', 'ver') in ['no', 'ver'];
    }
    function porCodigo() {
      return request.auth.token.email_verified == true && nuevo().keys().hasOnly(['nombre', 'correo', 'rol', 'codigo', 'activo', 'en'])
        && nuevo().codigo is string && nuevo().codigo != 'invitacion'
        && exists(rutaCodigo(nuevo().codigo, nuevo().rol))
        && get(rutaCodigo(nuevo().codigo, nuevo().rol)).data.activo == true
        && get(rutaCodigo(nuevo().codigo, nuevo().rol)).data.rol == nuevo().rol
        && (!esDireccion(nuevo().rol) || !existsAfter(rutaCodigo(nuevo().codigo, nuevo().rol)));
    }
    function porInvitacion() {
      return nuevo().codigo == 'invitacion' && request.auth.token.email_verified == true
        && nuevo().keys().hasOnly(['nombre', 'correo', 'rol', 'codigo', 'activo', 'en', 'permisos', 'extras'])
        && exists(rutaInv(request.auth.token.email))
        && get(rutaInv(request.auth.token.email)).data.rol == nuevo().rol
        && get(rutaInv(request.auth.token.email)).data.nombre == nuevo().nombre
        && get(rutaInv(request.auth.token.email)).data.get('permisos', {}) == nuevo().get('permisos', {})
        && get(rutaInv(request.auth.token.email)).data.get('extras', []) == nuevo().get('extras', [])
        && !existsAfter(rutaInv(request.auth.token.email));
    }
    match /usuarios/{uid} {
      // Cada quien lee el suyo; solo la Jefe con cuenta propia ve a todos (panel «Personas y permisos»).
      // Las personas de prueba (clave pública) no ven ni manejan cuentas propias.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if esCuentaDe(['jefe']);
      // Crear el perfil: solo el dueño, y de dos formas: con un código que exista, esté activo y sea del mismo rol, o con la
      // invitación que la Jefe hizo a su correo (ya confirmado). Los códigos de Gerente y Jefe, y las invitaciones, son de un solo uso.
      allow create: if request.auth != null && request.auth.uid == uid && !esPrueba()
        && nuevo().rol in ROLES() && nuevo().activo == true
        && nuevo().nombre is string && nuevo().nombre.size() >= 3 && nuevo().nombre.size() <= 60
        && nuevo().correo == request.auth.token.email
        && (porInvitacion() || porCodigo());
      // Cambiar rol, pausar, marcar permisos extra o dar niveles por módulo: solo la Jefe, y solo a quienes no son Gerente ni Jefe
      // (a ellos solo se les cambia algo desde la consola de Firebase). Nadie a sí mismo.
      allow update: if esCuentaDe(['jefe']) && request.auth.uid != uid
        && !esDireccion(antes().rol) && !esDireccion(nuevo().rol)
        && soloCambia(['rol', 'activo', 'extras', 'permisos'])
        && nuevo().rol in ROLES() && nuevo().activo is bool
        && nuevo().get('extras', []) is list && nuevo().get('extras', []).size() <= 5
        && nuevo().get('extras', []).hasOnly(['compra', 'actas', 'encargada'])
        && permisosOk(nuevo().get('permisos', {}));
      allow delete: if false;
    }

    // Códigos de los roles de trabajo (no Gerente ni Jefe). Solo los ve la Jefe con cuenta propia.
    match /codigos/{codigo} {
      allow read: if esCuentaDe(['jefe']);
      allow create: if esCuentaDe(['jefe'])
        && nuevo().keys().hasOnly(['rol', 'activo', 'por', 'en'])
        && nuevo().rol in ROLES() && !esDireccion(nuevo().rol) && nuevo().activo == true
        && codigo.size() >= 12;
      allow update: if false;
      // resource == null: ya lo había borrado otra persona (dos cambiando el código a la vez).
      allow delete: if esCuentaDe(['jefe']);
    }

    // Códigos de Gerente y Jefe: solo se crean a mano en la consola de Firebase (la app no puede crearlos, así una cuenta
    // robada de la Jefe no se llena de Gerentes). La Jefe los ve, y cada uno sirve una sola vez.
    match /codigosDireccion/{codigo} {
      allow read: if esCuentaDe(['jefe']);
      allow create: if false;
      allow update: if false;
      // Lo borra el Gerente, o quien lo está usando para crear su perfil en esa misma escritura.
      allow delete: if esCuentaDe(['jefe'])
        || (request.auth != null && !exists(rutaPerfil()) && getAfter(rutaPerfil()).data.codigo == codigo);
    }

    // Avisos de la campana: cualquiera los crea, pero con SU cuenta (deUid), solo con los campos de siempre, textos de largo razonable,
    // para un rol que existe y sin nacer leídos. Así nadie escribe un aviso a nombre de otra persona ni los llena de basura.
    // Cada quien solo cambia SU marca de leído (con su id de cuenta).
    // La Jefe de prueba puede reescribirlos (al cargar o reiniciar los datos de prueba se reemplazan los avisos de ejemplo).
    match /avisos/{id} {
      allow read: if esDemo();
      allow create: if (esPrueba() && esJefe())
        || (esDemo() && nuevo().keys().hasOnly(['para', 'titulo', 'texto', 'en', 'modulo', 'leido', 'deUid'])
            && nuevo().deUid == request.auth.uid && nuevo().para in ROLES()
            && nuevo().titulo is string && nuevo().titulo.size() <= 150 && nuevo().texto is string && nuevo().texto.size() <= 800
            && nuevo().en is string && nuevo().modulo in ['equipos', 'inventario', 'vehiculos', 'reuniones'] && nuevo().leido == {});
      allow update: if esJefe()
        || (esDemo() && soloCambia(['leido'])
            && nuevo().leido.diff(antes().get('leido', {})).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if esJefe();
    }

    // Los teléfonos con avisos activados NO están en Firestore: los guarda el Worker de avisos (Cloudflare KV), que revisa el token
    // de Firebase y saca el rol de la base. Así nadie con sesión puede leer, copiar ni borrar los teléfonos de los demás.
    match /suscripciones/{id} {
      allow read, write: if false;
    }
  }
}
